# Docker Compose Environment Variables
# Copy this file to .env and configure with your actual values

# Canton Configuration (REQUIRED)
# Get these from your Canton network setup
ADMIN_M2M_TOKEN=your-m2m-token-here
PLATFORM_ADMIN_PARTY=your-platform-admin-party-here

# Canton Configuration (Optional - defaults provided)
CANTON_JSON_API_URL=https://api.validator.devnet.sandbox.fivenorth.io/api/json-api
CANTON_LEDGER_ID=5nsandbox-devnet-1
CANTON_APPLICATION_ID=unhedged-prediction-markets-backend
PACKAGE_ID=d1bae0fa683dcd95581eb576320a4d945ee6b680e711561b53cbd0f1c627537d

# Rate Limiting (Optional)
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000

# Logging (Optional)
LOG_LEVEL=info

# Note: Database and Redis URLs are configured automatically in docker-compose.yml
# The following environment variables are set by Docker Compose:
# - DATABASE_URL=postgresql://unhedged:unhedged_dev_password@postgres:5432/unhedged?schema=public
# - REDIS_HOST=redis
# - REDIS_PORT=6379
# - REDIS_ENABLED=true
